{
  "name": "alumni-mentorship-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed/index.ts",
    "reset": "tsx src/db/reset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "backup": "tsx src/db/backup.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.0",
    "nodemailer": "^10.0.12",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
