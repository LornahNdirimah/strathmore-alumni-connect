# Copy to .env and fill in. `npm run dev` fails fast if JWT_SECRET is missing or weak.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# Must be >= 32 chars. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Browser origin allowed to call this API with credentials.
CORS_ORIGIN=http://localhost:5173

# SQLite file, relative to backend/
DATABASE_PATH=./data/app.db

# Python executable + the matching engine package root used by the ML worker.
PYTHON_BIN=python3
ML_ENGINE_DIR=../ml-matching/MachineLearning
# Set to "false" to boot the API without the matching worker (tests, CI).
ML_WORKER_ENABLED=true

# Email. In development, "smtp" delivers to Mailpit (npm run mail), a local
# test inbox: open http://localhost:8025 to read what the platform sent.
# Nothing leaves your machine. Use "console" to print emails to this log
# instead when Mailpit is not running.
MAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="Strathmore Alumni Connect <no-reply@alumni-connect.local>"
# Where links in emails point (the frontend). Defaults to CORS_ORIGIN.
# APP_URL=http://localhost:5173
