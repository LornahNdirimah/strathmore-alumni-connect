{
  "name": "alumni-mentorship-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "serve": "node scripts/serve.mjs",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:design": "vite --host 0.0.0.0",
    "mail": "node scripts/mailpit.mjs",
    "setup": "npm --prefix backend install && npm --prefix frontend install && npm run db:reset && npm run db:seed",
    "db:migrate": "npm --prefix backend run migrate",
    "db:seed": "npm --prefix backend run seed",
    "db:reset": "npm --prefix backend run reset",
    "db:backup": "npm --prefix backend run backup",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "typecheck": "npm --prefix backend run typecheck && npm --prefix frontend run typecheck",
    "test": "npm --prefix backend run test && npm run test:frontend && npm run test:ml",
    "test:backend": "npm --prefix backend run test",
    "test:frontend": "npm --prefix frontend run test",
    "test:e2e": "npm --prefix e2e test",
    "test:ml": "cd ml-matching/MachineLearning && python3 -m pytest -q",
    "verify": "npm run typecheck && npm run test && npm --prefix frontend run build",
    "format": "oxfmt"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "oxfmt": "^0.2.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
